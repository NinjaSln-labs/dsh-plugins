{
  "name": "dsh-subagent-router",
  "description": "Model-routed subagent delegation for DeepSeek Harness: a `subagent_model` tool with per-call provider/model/max_tokens overrides and a built-in `model: \"auto\"` routing policy (anchored to the parent's own model by default; task-tier upgrades, failure escalation, auditable reason), plus a `subagent_models` catalog tool. Children no longer need to inherit the parent's model.",
  "version": "0.1.1",
  "author": {
    "name": "ninjasln",
    "url": "https://github.com/NinjaSln-labs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaSln-labs/dsh-plugins.git",
    "directory": "dsh-subagent-router"
  },
  "homepage": "https://github.com/NinjaSln-labs/dsh-plugins/tree/main/dsh-subagent-router#readme",
  "bugs": {
    "url": "https://github.com/NinjaSln-labs/dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "subagent",
    "model-routing",
    "llm",
    "auto",
    "delegation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "test": "vitest run"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
