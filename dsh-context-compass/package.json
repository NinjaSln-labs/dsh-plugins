{
  "name": "dsh-context-compass",
  "description": "Session health for DeepSeek Harness: real token-meter data, configurable continue-vs-new decision model. Reactive header badge (compaction-aware), /compass command, context_compass tool.",
  "version": "0.11.0",
  "author": {
    "name": "ninjasln",
    "url": "https://github.com/NinjaSln-labs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaSln-labs/dsh-plugins.git",
    "directory": "dsh-context-compass"
  },
  "homepage": "https://github.com/NinjaSln-labs/dsh-plugins/tree/main/dsh-context-compass#readme",
  "bugs": {
    "url": "https://github.com/NinjaSln-labs/dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "context",
    "token-meter",
    "compaction",
    "continue-vs-new"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "smoke": "node scripts/smoke.mjs",
    "mount": "node scripts/mount.mjs",
    "release-check": "node scripts/release-check.mjs",
    "contract-check": "node scripts/contract-check.mjs",
    "visual": "playwright test -c visual/playwright.config.mjs",
    "visual:update": "playwright test -c visual/playwright.config.mjs --update-snapshots"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "typescript": "^5.0.0"
  }
}
